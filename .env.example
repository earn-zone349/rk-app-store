# Copy this file to .env and fill in your own Supabase project values.
# Never commit the real .env file. Only the anon/public key goes here —
# the service-role key must never be used in frontend code.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Phase 6 — CAPTCHA (Cloudflare Turnstile). This is the SITE key (public,
# safe to ship to the browser). The matching SECRET key goes into your
# Supabase project's Auth settings, not here — see SECURITY_SETUP.md.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Phase 6 — VIRUSTOTAL_API_KEY is NOT set here. It's an Edge Function
# secret (server-side only), set via:
#   supabase secrets set VIRUSTOTAL_API_KEY=your-key
# Never put it in this file or anywhere with a VITE_ prefix — anything
# VITE_-prefixed ends up in the browser bundle.

# #69 — Firebase Cloud Messaging (push notifications). These are all
# PUBLIC identifiers (safe in the browser bundle) — see FCM_SETUP.md for
# where to get each one. The actual secret (service account private key
# used to SEND notifications) is an Edge Function secret, never here.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_VAPID_KEY=your-web-push-vapid-key

# #85 — Sentry error monitoring (optional). Leave unset and the app runs
# exactly as before — see MONITORING_SETUP.md.
VITE_SENTRY_DSN=
